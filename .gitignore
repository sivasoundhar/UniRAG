# Secrets — real API keys live here, never committed.
.env

# Virtual environments
venv/
.venv/

# Python bytecode caches
__pycache__/
*.pyc

# Runtime data — uploaded files and the derived vector index are
# regenerated, not source; see CLAUDE.md §10.
data/uploads/
data/chroma_db/

# Test/tool caches
.pytest_cache/

# Logs
*.log

# Streamlit local secrets, if this project ever adds one — NOT the whole
# .streamlit/ directory: streamlit_app/.streamlit/config.toml is the app's
# real dark-theme config (see UI_UPGRADE_SPEC.md) and must be committed, or
# the deployed app silently loses its theme. secrets.toml (API keys, if
# Streamlit's own secrets manager is ever used instead of .env) is the
# actual local/sensitive file this rule exists to catch.
**/.streamlit/secrets.toml

# Editor/OS cruft
.vscode/
.idea/
.DS_Store

# Claude Code local tool state — session/machine-specific, not project source.
.claude/

# Local-only build/dev-process notes — kept on disk for reference, not
# published: internal day-by-day build log, fast-recall summary, and the
# UI's iterative design-conversation spec.
docs/CLAUDE.md
PROJECT_SUMMARY.md
UI_UPGRADE_SPEC.md
docs/unirag-interview-prep.html
